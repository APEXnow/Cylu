IDD_NEWMAZE DIALOG DISCARDABLE  0, 0, 204, 124
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Maze"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_EDIT_WIDTH,84,44,40,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_HEIGHT,84,62,40,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,49,103,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,105,103,50,14
    LTEXT           "Creating a new maze will destroy any existing maze stored in memory.  Please enter the attributres and select Ok when ready.",
                    IDC_STATIC,13,14,176,27
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDFRAME,7,7,190,87
    LTEXT           "Width",IDC_STATIC,60,44,20,14
    LTEXT           "Height",IDC_STATIC,58,62,22,14
END

IDD_SELECT_OBJECT DIALOG DISCARDABLE  0, 0, 119, 114
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,7,93,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,62,93,50,14
    COMBOBOX        IDC_OBJECT_COMBO,7,20,104,49,CBS_SIMPLE | WS_VSCROLL | 
                    WS_TABSTOP
    EDITTEXT        IDC_ATTRIB_EDIT,43,74,69,14,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "Spin2",IDC_ATTRIB_SPIN,"msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNLEFT | UDS_AUTOBUDDY | 
                    UDS_ARROWKEYS,32,74,14,14
    LTEXT           "Object",IDC_STATIC,7,7,22,8
    LTEXT           "Attribute",IDC_STATIC,7,76,27,8
END

IDD_PARSER DIALOG DISCARDABLE  0, 0, 188, 78
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,131,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,131,25,50,14
    LTEXT           "",IDC_STATISTICS,7,7,118,64,SS_SUNKEN | WS_BORDER
END


